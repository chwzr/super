{
  "Agent": {
    "type": "object",
    "properties": {
      "description": {
        "type": "string"
      },
      "prompt": {
        "type": "string"
      },
      "subagent_type": {
        "type": "string"
      },
      "model": {
        "type": "string"
      },
      "effort": {
        "type": "string"
      },
      "run_in_background": {
        "type": "boolean"
      },
      "isolation": {
        "type": "string",
        "enum": [
          "worktree",
          "remote"
        ]
      }
    },
    "required": [
      "description",
      "prompt"
    ],
    "additionalProperties": false
  },
  "Bash": {
    "type": "object",
    "properties": {
      "command": {
        "type": "string"
      },
      "timeout": {
        "type": "number"
      },
      "description": {
        "type": "string"
      },
      "run_in_background": {
        "type": "boolean"
      },
      "dangerouslyDisableSandbox": {
        "type": "boolean"
      }
    },
    "required": [
      "command"
    ],
    "additionalProperties": false
  },
  "Edit": {
    "type": "object",
    "properties": {
      "file_path": {
        "type": "string"
      },
      "old_string": {
        "type": "string"
      },
      "new_string": {
        "type": "string"
      },
      "replace_all": {
        "default": false,
        "type": "boolean"
      }
    },
    "required": [
      "file_path",
      "old_string",
      "new_string"
    ],
    "additionalProperties": false
  },
  "ListAgents": {
    "type": "object",
    "properties": {
      "channel": {
        "type": "string",
        "maxLength": 256
      },
      "q": {
        "type": "string",
        "maxLength": 256
      },
      "cursor": {
        "type": "string",
        "maxLength": 256
      }
    },
    "additionalProperties": false
  },
  "Read": {
    "type": "object",
    "properties": {
      "file_path": {
        "type": "string"
      },
      "offset": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "limit": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "allow_large": {
        "type": "boolean"
      }
    },
    "required": [
      "file_path"
    ],
    "additionalProperties": false
  },
  "ScheduleWakeup": {
    "type": "object",
    "properties": {
      "delaySeconds": {
        "type": "number"
      },
      "reason": {
        "type": "string"
      },
      "prompt": {
        "type": "string"
      },
      "stop": {
        "type": "boolean"
      },
      "noop": {
        "type": "boolean"
      }
    },
    "additionalProperties": false
  },
  "Skill": {
    "type": "object",
    "properties": {
      "skill": {
        "type": "string"
      },
      "args": {
        "type": "string"
      }
    },
    "required": [
      "skill"
    ],
    "additionalProperties": false
  },
  "Workflow": {
    "type": "object",
    "properties": {
      "script": {
        "type": "string",
        "maxLength": 524288
      },
      "name": {
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "args": {},
      "scriptPath": {
        "type": "string"
      },
      "resumeFromRunId": {
        "type": "string",
        "pattern": "^wf_[a-z0-9-]{6,}$"
      }
    },
    "additionalProperties": false
  },
  "Write": {
    "type": "object",
    "properties": {
      "file_path": {
        "type": "string"
      },
      "content": {
        "type": "string"
      }
    },
    "required": [
      "file_path",
      "content"
    ],
    "additionalProperties": false
  },
  "EnterWorktree": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string"
      },
      "path": {
        "type": "string"
      }
    },
    "additionalProperties": false
  },
  "ExitWorktree": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "keep",
          "remove"
        ]
      },
      "discard_changes": {
        "type": "boolean"
      }
    },
    "required": [
      "action"
    ],
    "additionalProperties": false
  },
  "Monitor": {
    "type": "object",
    "properties": {
      "description": {
        "type": "string"
      },
      "timeout_ms": {
        "default": 300000,
        "type": "number",
        "minimum": 1000,
        "maximum": 3600000
      },
      "command": {
        "type": "string"
      },
      "ws": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "protocols": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
            }
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "description",
      "timeout_ms"
    ],
    "additionalProperties": false
  },
  "SendMessage": {
    "type": "object",
    "properties": {
      "to": {
        "type": "string",
        "allOf": [
          {
            "pattern": "^[^\\n\\r]*$"
          },
          {
            "pattern": "^[\\s\\S]{0,300}$"
          }
        ]
      },
      "summary": {
        "type": "string",
        "maxLength": 200
      },
      "message": {
        "default": "",
        "type": "string"
      },
      "notify_when_idle": {
        "type": "boolean"
      }
    },
    "required": [
      "to",
      "message"
    ],
    "additionalProperties": false
  },
  "TaskStop": {
    "type": "object",
    "properties": {
      "task_id": {
        "type": "string"
      },
      "shell_id": {
        "type": "string"
      }
    },
    "additionalProperties": false
  }
}
