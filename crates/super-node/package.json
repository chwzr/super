{
  "name": "@super-sdk/node",
  "version": "0.0.3",
  "description": "N-API TypeScript SDK for the super coding agent (Node.js, Bun, and Deno)",
  "license": "MIT",
  "repository": "github:chwzr/super",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "super.node", "README.md"],
  "engines": {"node": ">=20"},
  "scripts": {
    "build:native": "cargo build --release && node scripts/copy-native.mjs",
    "build:ts": "tsc -p tsconfig.json",
    "build": "npm run build:native && npm run build:ts",
    "test": "node --test test/*.test.cjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
