{
  "name": "@super-sdk/core-wasm",
  "version": "0.0.8",
  "description": "Full SUPER agent kernel running inside browser WebAssembly",
  "type": "module",
  "module": "./browser.js",
  "types": "./browser.d.ts",
  "exports": {
    ".": {
      "types": "./browser.d.ts",
      "import": "./browser.js"
    }
  },
  "files": [
    "browser.js",
    "browser.d.ts",
    "pkg/super_core_wasm.js",
    "pkg/super_core_wasm_bg.wasm",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "wasm-pack build --target web --release",
    "test": "deno test --allow-read --allow-net test/*.ts",
    "test:size": "node test/size.mjs && node test/wasm_memory.mjs"
  },
  "sideEffects": ["./pkg/super_core_wasm.js"],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chwzr/super.git",
    "directory": "crates/super-core-wasm"
  }
}
